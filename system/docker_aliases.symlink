##
# Docker

# General
docker_dir="/home/$USER/docker"
alias ddir="cd $docker_dir"

##
# Source: https://github.com/htpcBeginner/docker-traefik/blob/master/.bash_aliases.example

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------

# Status
alias ddf='sudo docker system df'
alias ddfv='sudo docker system df -v'
alias dps='sudo docker ps -a'

# Image cleanup
alias dprune='sudo docker image prune'
alias dprunea='sudo docker image prune -a'

# Full Docker cleanup
alias dsysprune='sudo docker system prune'
alias dsysprunea='sudo docker system prune -a'

# Utilities
alias dexec='sudo docker exec -it'
dbash() { sudo docker exec -it "$1" /bin/bash; }
dsh()   { sudo docker exec -it "$1" /bin/sh; }


# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------

# Base Compose command
alias dccmd="sudo docker compose --file $docker_dir/docker-compose.yml --env-file $docker_dir/.env"

# Status
alias dccfg='dccmd config'

# Stack lifecycle
alias dcup='dccmd up -d'
alias dcdown='dccmd down'
alias dcstart='dccmd start'
alias dcstop='dccmd stop'
alias dcrestart='dccmd restart'
alias dcrec='dccmd up -d --force-recreate'
alias dcrm='dccmd rm'

# Images / logs
alias dcpull='dccmd --parallel 16 pull'
alias dclogs='dccmd logs -tf --tail="50"'

# Backup
alias dbackup='sudo systemctl start docker_backup && sudo journalctl -fu docker_backup -n 20'
alias dbackuplog='sudo journalctl -fu docker_backup -n 50'
alias dbackupstatus='sudo systemctl status docker_backup'
