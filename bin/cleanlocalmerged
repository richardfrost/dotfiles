#!/bin/bash
set -euo pipefail

# Fetches all remotes (like origin, upstream) and updates your remote-tracking branches
# prunes stale refs that no longer exist on the remote
git remote update --prune

# List merged local branches without xargs (branch names can contain quotes/spaces).
current=$(git symbolic-ref -q --short HEAD 2>/dev/null || true)
msg=""
had_delete=false
while IFS= read -r branch; do
  [ -z "$branch" ] && continue
  [ "$branch" = main ] && continue
  [ -n "$current" ] && [ "$branch" = "$current" ] && continue
  had_delete=true
  line=$(git branch -d "$branch" 2>&1) || true
  msg+=$line$'\n'
done < <(git for-each-ref --format='%(refname:short)' refs/heads/ --merged main)

if ! $had_delete; then
  echo "No local merged branches to clean up"
else
  echo "Deleted the following merged branches:"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    printf "  - %s\n" "$line"
  done <<< "$msg"
fi
